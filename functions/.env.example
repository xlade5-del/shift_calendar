# Firebase API Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Firebase Web API Key
# Get this from Firebase Console → Project Settings → General → Web API Key
# Or from lib/firebase_options.dart after running flutterfire configure
FIREBASE_API_KEY=your_firebase_api_key_here

# Usage examples:
# node verify-email-simple.js test@example.com password123
# The script will automatically read FIREBASE_API_KEY from environment
